# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Committed template for .env
# Copy this to .env and fill in real values. Never commit .env itself.
# ──────────────────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# Database connection string
DATABASE_URL=sqlite:///./storage/app.db

# Absolute path to the Tesseract OCR binary (machine-specific)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS example: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
